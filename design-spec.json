ype":"button","bg":"ink","color":"white","outline":true},{"key":"dhcaption","parent":"dhleft","text":"Пришлите общий снимок мебели и крупным планом загрязнения — этого достаточно для предварительной оценки.","w":570,"size":13,"type":"text","color":"white"},{"key":"dhright","parent":"dhero","w":576,"type":"frame","gap":16},{"key":"dhphoto","parent":"dhright","crop":[606,208,198,96],"w":576,"h":510,"type":"image","radius":32},{"key":"dhbadge","parent":"dhright","w":576,"type":"frame","bg":"lime","px":24,"py":20,"radius":20},{"key":"dhbt","parent":"dhbadge","text":"Чистим на дому в Москве","w":528,"size":20,"type":"text","bold":true}]},{"name":"Услуги","root":"dservices","ops":[{"key":"dservices","parent":"desktop","w":1440,"type":"frame","px":80,"py":80,"gap":36},{"key":"dservtitle","parent":"dservices","text":"Поможем привести мягкую мебель в порядок\nбез поездок в химчистку","w":1180,"size":40,"type":"text","bold":true},{"key":"dservrow","parent":"dservices","w":1280,"type":"frame","dir":"HORIZONTAL","gap":24},{"key":"dc0","parent":"dservrow","w":302,"type":"frame","gap":18},{"key":"dci0","parent":"dc0","crop":[39,449,114,65],"w":302,"h":224,"type":"image"},{"key":"dct0","parent":"dc0","text":"Диваны","w":302,"size":28,"type":"text","bold":true},{"key":"dcd0","parent":"dc0","text":"Удаляем бытовые загрязнения и освежаем обивку с учётом типа материала.","w":286,"size":16,"type":"text"},{"key":"dc1","parent":"dservrow","w":302,"type":"frame","gap":18},{"key":"dci1","parent":"dc1","crop":[169,449,114,65],"w":302,"h":224,"type":"image"},{"key":"dct1","parent":"dc1","text":"Кресла","w":302,"size":28,"type":"text","bold":true},{"key":"dcd1","parent":"dc1","text":"Подбираем средство и способ чистки под конкретную ткань и состояние обивки.","w":286,"size":16,"type":"text"},{"key":"dc2","parent":"dservrow","w":302,"type":"frame","gap":18},{"key":"dci2","parent":"dc2","crop":[298,449,114,65],"w":302,"h":224,"type":"image"},{"key":"dct2","parent":"dc2","text":"Матрасы","w":302,"size":28,"type":"text","bold":true},{"key":"dcd2","parent":"dc2","text":"Очищаем обивку экстракционным методом с учётом материала и характера загрязнений.","w":286,"size":16,"type":"text"},{"key":"dc3","parent":"dservrow","w":302,"type":"frame","gap":18},{"key":"dci3","parent":"dc3","crop":[428,449,114,65],"w":302,"h":224,"type":"image"},{"key":"dct3","parent":"dc3","text":"Стулья","w":302,"size":28,"type":"text","bold":true},{"key":"dcd3","parent":"dc3","text":"Чистим тканевую обивку, удаляем основные пятна, следы и особенности материала.","w":286,"size":16,"type":"text"},{"key":"dservb","parent":"dservices","text":"Рассчитать стоимость моей мебели","w":408,"type":"button"}]},{"name":"Проверка мебели","root":"dtrust","ops":[{"key":"dtrust","parent":"desktop","w":1440,"type":"frame","dir":"HORIZONTAL","px":80,"py":72,"gap":64,"bg":"pale"},{"key":"dtleft","parent":"dtrust","w":576,"type":"frame","gap":24},{"key":"dtth","parent":"dtleft","text":"Сначала проверяем мебель.\nТолько потом начинаем чистку","w":576,"size":39,"type":"text","bold":true},{"key":"dttp","parent":"dtleft","text":"Разные ткани и загрязнения требуют разного подхода. Перед основной чисткой мастер оценивает материал, определяет характер загрязнений, подбирает подходящее средство и проверяет его на незаметном участке.","w":560,"size":18,"type":"text"},{"key":"dttn","parent":"dtleft","text":"Если заранее видно, что какое-либо пятно может не удалиться полностью, сообщаем об этом до начала работы.","w":560,"size":16,"type":"text"},{"key":"dtright","parent":"dtrust","w":640,"type":"frame","gap":20},{"key":"dtr0","parent":"dtright","w":640,"type":"frame","dir":"HORIZONTAL","gap":20},{"key":"dtc0","parent":"dtr0","w":310,"type":"frame","bg":"white","radius":22,"px":24,"py":28,"gap":18},{"key":"dtct0","parent":"dtc0","text":"Проверяем ткань","w":262,"size":21,"type":"text","bold":true},{"key":"dtcb0","parent":"dtc0","text":"Определяем особенности материала перед основной чисткой.","w":262,"size":16,"type":"text"},{"key":"dtc1","parent":"dtr0","w":310,"type":"frame","bg":"white","radius":22,"px":24,"py":28,"gap":18},{"key":"dtct1","parent":"dtc1","text":"Подбираем состав","w":262,"size":21,"type":"text","bold":true},{"key":"dtcb1","parent":"dtc1","text":"Не используем одно средство для любой мебели.","w":262,"size":16,"type":"text"},{"key":"dtr1","parent":"dtright","w":640,"type":"frame","dir":"HORIZONTAL","gap":20},{"key":"dtc2","parent":"dtr1","w":310,"type":"frame","bg":"white","radius":22,"px":24,"py":28,"gap":18},{"key":"dtct2","parent":"dtc2","text":"Тестируем средство","w":262,"size":21,"type":"text","bold":true},{"key":"dtcb2","parent":"dtc2","text":"Проверяем реакцию ткани на незаметном участке.","w":262,"size":16,"type":"text"},{"key":"dtc3","parent":"dtr1","w":310,"type":"frame","bg":"white","radius":22,"px":24,"py":28,"gap":18},{"key":"dtct3","parent":"dtc3","text":"Согласовываем стоимость","w":262,"size":21,"type":"text","bold":true},{"key":"dtcb3","parent":"dtc3","text":"До начала работы клиент понимает стоимость услуги.","w":262,"size":16,"type":"text"}]},{"name":"Метод чистки","root":"dextract","ops":[{"key":"dextract","parent":"desktop","w":1440,"type":"frame","dir":"HORIZONTAL","px":80,"py":80,"gap":64,"align":"CENTER"},{"key":"deimage","parent":"dextract","crop":[39,846,238,179],"w":576,"h":480,"type":"image","radius":32},{"key":"deright","parent":"dextract","w":640,"type":"frame","gap":24},{"key":"deh","parent":"deright","text":"Загрязнения извлекаем из обивки,\nа не просто маскируем запах","w":640,"size":40,"type":"text","bold":true},{"key":"dep","parent":"deright","text":"Для основной чистки используем экстракционный метод. Чистящий раствор наносится на обивку, после чего профессиональное оборудование извлекает его вместе с растворёнными загрязнениями.","w":625,"size":18,"type":"text"},{"key":"den","parent":"deright","text":"Способ обработки подбирается под конкретную мебель, материал и состояние ткани.","w":625,"size":18,"type":"text"},{"key":"decall","parent":"deright","w":640,"type":"frame","bg":"lime","px":24,"py":24,"radius":20},{"key":"decallt","parent":"decall","text":"Не просто освежаем мебель —\nочищаем обивку с помощью профессионального оборудования.","w":592,"size":19,"type":"text","bold":true}]},{"name":"Как проходит чистка","root":"dprocess","ops":[{"key":"dprocess","parent":"desktop","w":1440,"type":"frame","px":80,"py":72,"gap":40,"bg":"ink"},{"key":"dph","parent":"dprocess","text":"От фотографии до чистой мебели — понятный процесс","w":1240,"size":39,"type":"text","bold":true,"color":"white"},{"key":"dprow","parent":"dprocess","w":1280,"type":"frame","dir":"HORIZONTAL","gap":28},{"key":"dp0","parent":"dprow","w":299,"type":"frame","gap":20},{"key":"dpn0","parent":"dp0","text":"1","w":299,"size":60,"type":"text","bold":true,"color":"lime"},{"key":"dpt0","parent":"dp0","text":"Отправляете фото","w":299,"size":21,"type":"text","bold":true,"color":"white"},{"key":"dpb0","parent":"dp0","text":"Присылаете общий снимок и фото загрязнений через сайт или WhatsApp.","w":289,"size":16,"type":"text","color":"white"},{"key":"dp1","parent":"dprow","w":299,"type":"frame","gap":20},{"key":"dpn1","parent":"dp1","text":"2","w":299,"size":60,"type":"text","bold":true,"color":"lime"},{"key":"dpt1","parent":"dp1","text":"Получаете расчёт","w":299,"size":21,"type":"text","bold":true,"color":"white"},{"key":"dpb1","parent":"dp1","text":"Оцениваем мебель и объём работы и сообщаем ориентировочную стоимость.","w":289,"size":16,"type":"text","color":"white"},{"key":"dp2","parent":"dprow","w":299,"type":"frame","gap":20},{"key":"dpn2","parent":"dp2","text":"3","w":299,"size":60,"type":"text","bold":true,"color":"lime"},{"key":"dpt2","parent":"dp2","text":"Согласовываем выезд","w":299,"size":21,"type":"text","bold":true,"color":"white"},{"key":"dpb2","parent":"dp2","text":"Выбираем удобное время приезда мастера.","w":289,"size":16,"type":"text","color":"white"},{"key":"dp3","parent":"dprow","w":299,"type":"frame","gap":20},{"key":"dpn3","parent":"dp3","text":"4","w":299,"size":60,"type":"text","bold":true,"color":"lime"},{"key":"dpt3","parent":"dp3","text":"Проверяем и чистим","w":299,"size":21,"type":"text","bold":true,"color":"white"},{"key":"dpb3","parent":"dp3","text":"На месте мастер оценивает материал, проверяет средство и выполняет химчистку подходящим способом.","w":289,"size":16,"type":"text","color":"white"},{"key":"dpdry","parent":"dprocess","w":1280,"type":"frame","bg":"lime","radius":22,"px":32,"py":24,"gap":8},{"key":"dpdryh","parent":"dpdry","text":"≈ 6 часов — среднее время высыхания","w":1216,"size":26,"type":"text","bold":true},{"key":"dpdryp","parent":"dpdry","text":"Точное время зависит от материала обивки, температуры и вентиляции в помещении.\nПосле чистки мастер подскажет, когда мебелью можно будет пользоваться.","w":1216,"size":16,"type":"text"}]},{"name":"Расчёт стоимости","root":"dquote","ops":[{"key":"dquote","parent":"desktop","w":1440,"type":"frame","dir":"HORIZONTAL","px":80,"py":80,"gap":80,"align":"CENTER"},{"key":"dqleft","parent":"dquote","w":560,"type":"frame","gap":24},{"key":"dqh","parent":"dqleft","text":"Сначала узнайте стоимость —\nпотом решайте","w":560,"size":44,"type":"text","bold":true},{"key":"dqp","parent":"dqleft","text":"Стоимость химчистки зависит от типа мебели, её размера, материала обивки и характера загрязнений.","w":540,"size":19,"type":"text"},{"key":"dqp2","parent":"dqleft","text":"Чтобы узнать ориентировочную цену,\nне обязательно сразу вызывать мастера.\nПришлите несколько фотографий — предварительно оценим работу и сообщим стоимость до согласования выезда.","w":540,"size":19,"type":"text"},{"key":"dqb1","parent":"dqleft","text":"Получить расчёт по фото","w":420,"type":"button"},{"key":"dqb2","parent":"dqleft","text":"Отправить фото в WhatsApp","w":420,"type":"button","bg":"paper","outline":true},{"key":"dqform","parent":"dquote","w":640,"type":"frame","bg":"white","radius":28,"px":32,"py":32,"gap":20},{"key":"dqfh","parent":"dqform","text":"Узнайте стоимость химчистки по фото","w":576,"size":26,"type":"text","bold":true},{"key":"dqfp","parent":"dqform","text":"Заполните короткую форму — для предварительной оценки достаточно нескольких фотографий.","w":576,"size":16,"type":"text"},{"key":"dqfl","parent":"dqform","text":"Что нужно почистить?","w":576,"size":15,"type":"text","bold":true},{"key":"dqchips","parent":"dqform","w":576,"type":"frame","dir":"HORIZONTAL","gap":8},{"key":"dqchip0","parent":"dqchips","text":"Диван","w":108,"type":"button","h":42,"bg":"ink","color":"white","size":14},{"key":"dqchip1","parent":"dqchips","text":"Кресло","w":108,"type":"button","h":42,"bg":"paper","color":"ink","size":14},{"key":"dqchip2","parent":"dqchips","text":"Матрас","w":108,"type":"button","h":42,"bg":"paper","color":"ink","size":14},{"key":"dqchip3","parent":"dqchips","text":"Стулья","w":108,"type":"button","h":42,"bg":"paper","color":"ink","size":14},{"key":"dqchip4","parent":"dqchips","text":"Другое","w":108,"type":"button","h":42,"bg":"paper","color":"ink","size":14},{"key":"dqfphoto","parent":"dqform","text":"Прикрепите фотографии","w":576,"size":15,"type":"text","bold":true},{"key":"dqupload","parent":"dqform","w":576,"type":"frame","bg":"pale","radius":16,"px":20,"py":24,"gap":12,"align":"CENTER"},{"key":"dqupb","parent":"dqupload","text":"Добавить фотографии","w":290,"type":"button","bg":"pale","outline":true},{"key":"dqupn","parent":"dqupload","text":"Лучше добавить один общий снимок мебели и фото загрязнений крупным планом.","w":536,"size":12,"type":"text","align":"CENTER"},{"key":"dqcomment","parent":"dqform","type":"input","w":576,"text":"Комментарий (необязательно)","value":"Например: пятно от кофе, следы животных, запах и т.д."},{"key":"dqphone","parent":"dqform","type":"input","w":576,"text":"Ваш телефон","value":"+7 (___) ___-__-__"},{"key":"dqactions","parent":"dqform","w":576,"type":"frame","dir":"HORIZONTAL","gap":12},{"key":"dqsubmit","parent":"dqactions","text":"Получить р